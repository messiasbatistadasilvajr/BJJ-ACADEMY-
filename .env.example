# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# REDIS CONFIGURATION (Webhook Queue & Workers)
# Configure a Redis URL (e.g. redis://localhost:6379, Upstash, or Redis Cloud)
# If left unset, the backend automatically operates with an in-memory resilient fallback queue.
REDIS_URL="redis://localhost:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# CUSTOM DOMAIN & APPLICATION URLS
APP_DOMAIN="bjjacademy.app.br"
BASE_URL="https://bjjacademy.app.br"
ALLOWED_ORIGINS="https://bjjacademy.app.br,https://*.bjjacademy.app.br,http://localhost:3000"

